{
  "name": "dsh-bili-lesson",
  "version": "0.7.0",
  "description": "星火课堂：DSH 桌面端插件 —— 家长挑片、按周排课、孩子看完打勾、课卡判分、错题回炉、盲盒与勋章，附带家长锁。",
  "license": "MIT",
  "keywords": ["dsh", "dsh-plugin", "bilibili", "kids", "education"],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src/**/*.js",
    "cordis.patch.yml",
    "icon.svg",
    "LICENSE",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check src/store.js && node --check src/bili.js && node --check src/plan.js && node --check src/lesson.js && node --check src/routes.js && node --check src/rewards.js",
    "test": "node selftest.mjs",
    "check:load": "node _loadcheck.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  }
}
